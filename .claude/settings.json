{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./worksheets/**)",
      "Read(//Users/danyelabrown/Documents/reparations-pii/**)",
      "Read(./**/*intake-csv*)",
      "Read(./**/*Form Responses*)"
